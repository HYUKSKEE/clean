# 브랜드 / 연락처 (클라이언트에 노출되는 값)
#
# 모든 값은 비워두면 lib/site.ts 의 기본값이 사용됩니다.
# NEXT_PUBLIC_SITE_URL 을 지정하지 않으면 Vercel 배포 도메인을 자동으로 사용합니다.
# (스킴 없이 ppikka-clean.kr 처럼 입력해도 https:// 가 자동으로 붙습니다.)
NEXT_PUBLIC_SITE_URL=https://ppikka-clean.example.com
NEXT_PUBLIC_PHONE=010-0000-0000
NEXT_PUBLIC_EMAIL=hello@ppikka-clean.kr
NEXT_PUBLIC_LEGAL_NAME=삐까번쩍 클린서비스
NEXT_PUBLIC_OWNER=홍길동
NEXT_PUBLIC_BUSINESS_NUMBER=000-00-00000
NEXT_PUBLIC_ADDRESS=서울특별시 강서구 공항대로 000, 0층 000호
NEXT_PUBLIC_KAKAO_URL=

# 견적 문의 폼 전달 대상 (서버 전용).
# 비워 두면 폼은 "테스트 모드"로 동작하며 서버 로그에만 기록됩니다.
# Slack Incoming Webhook, Google Apps Script, 자체 API 등 어떤 엔드포인트든 사용 가능합니다.
CONTACT_WEBHOOK_URL=
